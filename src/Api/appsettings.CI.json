{
  "Identity": {
    "LoginLimits": {
      "Window": "00:15:00",
      "FreeFailures": 40,
      "DelaySecondsByFailure": "1,2,4",
      "PerIpCeiling": 500
    },
    "ForgotPassword": {
      "TokenLifetime": "00:30:00",
      "MinimumResponseTime": "00:00:00.2500000",
      "ResetLinkTemplate": "http://localhost:5173/app/password/reset#token={token}"
    }
  },
  "Invitations": {
    "PublicOrigin": "http://127.0.0.1:5080"
  },
  "Notifications": {
    "Email": {
      "Providers": {
        "local-mailpit": {
          "Host": "localhost",
          "Port": 1025,
          "UseStartTls": false
        }
      }
    }
  }
}
