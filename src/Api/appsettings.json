{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "app_user": "",
    "authenticator": "",
    "provisioner": ""
  },
  "Security": {
    "AllowedOrigins": []
  },
  "Network": {
    "TrustedProxies": []
  },
  "Identity": {
    "LoginLimits": {
      "Window": "00:15:00",
      "FreeFailures": 2,
      "DelaySecondsByFailure": "1,2,4,8,15",
      "PerIpCeiling": 50
    },
    "ForgotPassword": {
      "TokenLifetime": "00:30:00",
      "MinimumResponseTime": "00:00:01.5000000",
      "ResetLinkTemplate": "/app/password/reset#token={token}"
    }
  },
  "Notifications": {
    "Email": {
      "Timeout": "00:00:05",
      "CredentialSection": "Notifications:Email:Providers",
      "Providers": {}
    },
    "ProviderAccounts": { "CacheFor": "00:05:00" },
    "Dispatch": { "Capacity": 1024 }
  }
}
