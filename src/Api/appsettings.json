{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "app_user": "",
    "authenticator": "",
    "provisioner": ""
  },
  "Security": {
    "AllowedOrigins": []
  },
  "Identity": {
    "LoginLimits": {
      "Window": "00:15:00",
      "FreeFailures": 2,
      "DelaySecondsByFailure": [
        1,
        2,
        4,
        8,
        15
      ],
      "PerIpCeiling": 50
    }
  }
}
