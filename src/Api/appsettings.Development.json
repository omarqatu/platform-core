{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "app_user": "Host=localhost;Port=5432;Database=platform;Username=app_user;Password=app_user_dev",
    "authenticator": "Host=localhost;Port=5432;Database=platform;Username=authenticator;Password=authenticator_dev",
    "provisioner": "Host=localhost;Port=5432;Database=platform;Username=provisioner;Password=provisioner_dev"
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5173"
