{
  "name": "platform-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run i18n:compile",
    "dev": "vite",
    "prebuild": "npm run i18n:compile",
    "build": "tsc -p tsconfig.build.json && vite build",
    "pretypecheck": "npm run i18n:compile",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run i18n:compile",
    "test": "vitest run",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.test.{ts,tsx}\" --out-file locales/en.json --format simple --throws",
    "i18n:compile": "formatjs compile-folder --ast --format simple locales compiled-locales",
    "lint:self-test": "node scripts/lint-self-test.mjs",
    "check:logical-css": "node scripts/check-logical-css.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.3",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.32",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-formatjs": "^8.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
