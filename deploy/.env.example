# The test server's settings. Copy to deploy/.env ON THE SERVER, then:
#   chmod 600 deploy/.env        (the deploy refuses to run otherwise)
#   owned by deployer            (likewise)
# Never commit deploy/.env (.gitignore lists it). Every value below is a placeholder — none is real.
#
# Passwords: generate each one separately with
#   openssl rand -hex 32
# Hex only — a ";" would break a connection string and a "$" is read by Docker Compose as a variable.
#
# The five role passwords are written into PostgreSQL ONCE, by db/init/00-roles.sh, the first time the database
# volume is created. Changing them here afterwards changes nothing in the database — and Api then fails to connect.
# Changing one later is ALTER ROLE ... PASSWORD as postgres, then the same value here, then a redeploy.

# The public host name. Api accepts only this Host header and this Origin, and builds e-mail links on it.
PUBLIC_HOST=platform.example.com

# PostgreSQL's superuser (postgres). Used only by the container itself and by the init script.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# migrator: the owner, migrations only. Reaches only the one-shot "migrate" container — never Api, never Worker.
MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32

# app_user: Api and Worker, every tenant request.
APP_USER_PASSWORD=replace-with-openssl-rand-hex-32

# authenticator: Api, the login path.
AUTHENTICATOR_PASSWORD=replace-with-openssl-rand-hex-32

# job_runner: Worker only (lists the active tenants).
JOB_RUNNER_PASSWORD=replace-with-openssl-rand-hex-32

# provisioner: Api (and src/Ops, when it exists).
PROVISIONER_PASSWORD=replace-with-openssl-rand-hex-32

# E-mail through Gmail SMTP: port 587 with STARTTLS. SMTP_PASSWORD is a Google *App Password* (Google account →
# Security → 2-Step Verification → App passwords), never the account's own password. Google shows it as four groups
# of four letters: write it here WITHOUT the spaces. The sender address in provider_accounts must be this account
# (or an alias Gmail has verified for it).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=someone@example.com
SMTP_PASSWORD=replace-with-the-app-password
